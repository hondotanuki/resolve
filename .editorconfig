# このリポジトリを設定の起点にする
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.csproj]
indent_style = space
indent_size = 2

[*.props]
indent_style = space
indent_size = 2

[*.targets]
indent_style = space
indent_size = 2
